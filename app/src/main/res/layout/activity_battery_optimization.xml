<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_secondary"
    tools:context=".ui.BatteryOptimizationActivity">

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  HEADER                                               -->
    <!-- ══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="@dimen/header_padding_top"
        android:paddingBottom="28dp">

        <!-- Back hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_orbis_notification"
                android:contentDescription="Orbis"
                app:tint="@color/text_on_header_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORBIS AGENT"
                android:textSize="12sp"
                android:textColor="@color/text_on_header_dim"
                android:letterSpacing="0.08"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery Optimization"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_header"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep the agent running reliably in background"
            android:textSize="13sp"
            android:textColor="@color/text_on_header_dim" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════ -->
    <!--  CONTENT                                              -->
    <!-- ══════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md"
            android:paddingTop="20dp">

            <!-- Instructions card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/background_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- Icon + label row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_battery_warning"
                                android:contentDescription="Battery" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEVICE-SPECIFIC STEPS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.12"
                            android:layout_marginStart="12dp" />
                    </LinearLayout>

                    <!-- Instructions text -->
                    <TextView
                        android:id="@+id/textInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="5dp"
                        tools:text="1. Open Settings\n2. Apps → Orbis Agent\n3. Battery → Unrestricted" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary action button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpenBatterySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disable Battery Optimization"
                android:layout_marginBottom="10dp"
                style="@style/OrbisButton" />

            <!-- Secondary action button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonOpenAppSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open App Settings"
                style="@style/OrbisButton.Outlined" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
